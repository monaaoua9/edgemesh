    "y": 21,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(edge_forward_failures_total[1m])",
     "legendFormat": "failures",
     "refId": "A"
    },
    {
     "expr": "rate(edge_forward_dead_lettered_total[1m])",
     "legendFormat": "dead-lettered",
     "refId": "B"
    }
   ]
  }
 ]
}